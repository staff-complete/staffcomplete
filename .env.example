# Inbox that receives early-access requests — this is the entire signup store,
# there is no database. Read by the Cloudflare Pages Function.
EARLY_ACCESS_TO=

# Verified Resend sender, e.g. "Early Access <early-access@staffcomplete.io>"
EARLY_ACCESS_FROM=

# Resend API key for the early-access notification email
RESEND_API_KEY=

# Cloudflare Turnstile. Both are optional: leave them unset and the form falls
# back to its honeypot. Set both together if spam starts getting through.
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
