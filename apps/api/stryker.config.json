{
  "$schema": "../../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/lib/**/*.ts",
    "src/jobs/**/*.ts",
    "src/middleware/**/*.ts",
    "src/billing/**/*.ts",
    "src/routes/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "htmlReporter": {
    "fileName": "../../.stryker-reports/api.html"
  },
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "plugins": ["@stryker-mutator/vitest-runner"],
  "vitest": {
    "related": false
  },
  "ignorePatterns": ["dist"]
}
