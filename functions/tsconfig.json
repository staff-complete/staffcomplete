{
  "compilerOptions": {
    "target": "ES2022",
    // WebWorker gives us the Workers runtime globals (Request, Response,
    // fetch, FormData) without depending on @cloudflare/workers-types.
    "lib": ["ES2022", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [],
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
